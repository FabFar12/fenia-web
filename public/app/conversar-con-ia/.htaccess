# "Conversar con IA sin creerle todo" (ADR-030). Self-contained apps copied
# byte for byte from the product team: each file gets the exact policy it was
# tested with, carrying the hash of its own script and of its style. If one
# byte of a script or style changes, the browser blocks it: never edit these
# files by hand, ask for a regenerated file with new hashes. CI recomputes the
# hashes and compares them with this file (scripts/verify-app-csp.mjs).
#
# No mod_rewrite here: a RewriteEngine in this folder would switch off the
# HTTPS, www and staging-lock rules of the parent .htaccess for these files.
AddDefaultCharset UTF-8

<IfModule mod_headers.c>
  # Every update must reach whoever already started (progress lives in the
  # browser, under the same key, so replacing the file keeps it). `set`, not
  # `always set`: the same table as the parent's HTML rule, so it replaces it
  # instead of sending the header twice.
  Header set Cache-Control "no-cache"
  Header always set X-Robots-Tag "noindex, nofollow"

  <Files "muestra.html">
    Header always set Content-Security-Policy "default-src 'none'; script-src 'sha256-QE33CQCCa/RCn9XHCVUCgTsC+1kQ3jlsbbEeh3C6DjA='; style-src 'sha256-dP81i7td35xNT4Dt5JuBfghOD9IqL2GCEBTrklcUTWQ='; font-src data:; img-src data: blob:; base-uri 'none'; form-action 'none'; frame-ancestors 'self'"
  </Files>

  <Files "piloto.html">
    Header always set Content-Security-Policy "default-src 'none'; script-src 'sha256-Rhb8fkglCKiWiOf55O4t7aKltwSjt4T+dozK2ujTod8='; style-src 'sha256-dP81i7td35xNT4Dt5JuBfghOD9IqL2GCEBTrklcUTWQ='; font-src data:; img-src data: blob:; base-uri 'none'; form-action 'none'; frame-ancestors 'self'"
  </Files>
</IfModule>
