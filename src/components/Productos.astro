---
// Productos.astro — Sección de productos digitales FENIA
// Reads from src/content/products/ via Astro Content Collections.
// Status 'hidden' is never rendered. 'coming-soon' shows a "PRÓXIMAMENTE" suffix.
// CTA behavior: see ADR-027, ADR-028 and docs/ventas/propuesta-visual.md.
import { getCollection, getEntry } from 'astro:content';
import { Picture } from 'astro:assets';
import { whatsapp } from '../data/site';
import { formatPrice, isPurchasable, isTraining, kitUrl, notifyUrl, offerFor, productUrl } from '../lib/sales';

const allProducts = await getCollection('products');
// Trainings (ADR-030) are not kits: they have their own page, and a featured
// card above the kits when their copy has a `card` block (approved 2026-11-18).
const featured = (
  await Promise.all(
    allProducts
      .filter((p) => isTraining(p) && p.data.status !== 'hidden')
      .sort((a, b) => a.data.order - b.data.order)
      .map(async (product) => ({ product, page: await getEntry('trainings', product.id) })),
  )
).flatMap(({ product, page }) => (page?.data.card ? [{ product, copy: page.data, card: page.data.card }] : []));
const products = allProducts
  .filter((p) => !isTraining(p) && (p.data.status === 'live' || p.data.status === 'coming-soon'))
  .sort((a, b) => a.data.order - b.data.order);

const accentText = (a: 'cyan' | 'coral') => (a === 'cyan' ? '#00B4D8' : '#E8573D');
const accentBg = (a: 'cyan' | 'coral') => (a === 'cyan' ? 'rgba(0,180,216,0.1)' : 'rgba(232,87,61,0.1)');

// Shared launch-promo banner (variants 2/3): the first sellable kit's offer.
const bannerOffer = products.filter(isPurchasable).map((p) => offerFor(p)).find((o) => o !== null) ?? null;

const customRequestUrl = whatsapp.url('Hola FENIA, necesito un recurso personalizado para mi equipo u organización');

/**
 * CTA per product (ADR-028, docs/ventas/propuesta-visual.md):
 *  - purchasable (live with a price; also coming-soon on a staging preview
 *    build) → "Comprar" → the kit page, where the buyer's email is asked
 *  - coming-soon → "Avisame cuando esté disponible" → /recursos-gratuitos
 *    (D17: no free-resource promise until one exists; the title comes from
 *    the product id there, never from the URL — finding H-03)
 *  - live without a price → informational card, no button
 */
function ctaFor(product: (typeof products)[number]) {
  const { status, ctaLabel } = product.data;
  if (isPurchasable(product)) {
    return { label: ctaLabel ?? 'Comprar', href: kitUrl(product), primary: true };
  }
  if (status === 'coming-soon') {
    return { label: ctaLabel ?? 'Avisame cuando esté disponible', href: notifyUrl(product), primary: false };
  }
  return null;
}
---

<section id="productos" style="background:#0B1A2E;position:relative;overflow:hidden;">
  <div style="position:absolute;top:30%;right:10%;width:400px;height:400px;border-radius:50%;background:radial-gradient(ellipse,rgba(232,87,61,0.04) 0%,transparent 70%);pointer-events:none;"></div>

  <div style="max-width:1200px;margin:0 auto;padding:100px 48px;position:relative;z-index:2;">
    <!-- Header -->
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:60px;margin-bottom:56px;align-items:end;">
      <div>
        <div style="display:inline-flex;align-items:center;gap:8px;padding:5px 14px;border-radius:100px;border:1px solid rgba(255,255,255,0.08);margin-bottom:20px;">
          <div style="width:5px;height:5px;border-radius:50%;background:#E8573D;"></div>
          <span style="font-size:11px;font-weight:600;color:rgba(255,255,255,0.4);text-transform:uppercase;letter-spacing:0.1em;font-family:'Plus Jakarta Sans',sans-serif;">Productos digitales</span>
        </div>
        <h2 style="font-size:38px;font-weight:800;line-height:1.1;color:#fff;letter-spacing:-0.03em;margin:0;font-family:'Plus Jakarta Sans',sans-serif;">
          Recursos listos para <span style="color:#00B4D8;">implementar</span>
        </h2>
      </div>
      <p style="font-size:15px;line-height:1.7;color:rgba(255,255,255,0.7);margin:0;font-family:'Plus Jakarta Sans',sans-serif;">
        Herramientas basadas en evidencia, diseñadas para aplicar los principios de FENIA de forma autónoma e inmediata.
      </p>
    </div>

    {bannerOffer && (
      <!-- Launch promo banner (D23): total length, days already run, time left. -->
      <div class="promo-banner" data-offer={bannerOffer.json}>
        <div class="promo-card" data-offer-promo hidden={!bannerOffer.activeAtBuild}>
          <div class="promo-info">
            <span class="promo-chip">−{bannerOffer.percent}% · Lanzamiento</span>
            <p class="promo-title">{bannerOffer.label} en los 3 kits</p>
            <p class="promo-period">Oferta de {bannerOffer.totalDays} días: {bannerOffer.period}, hasta las 23:59 (hora de Argentina).</p>
            <div class="promo-progress" aria-hidden="true">
              {Array.from({ length: bannerOffer.totalDays }, (_, i) => <span data-offer-seg={i + 1}></span>)}
            </div>
            <p class="promo-day" data-offer-day>Día 1 de {bannerOffer.totalDays}</p>
          </div>
          <div class="promo-left" aria-hidden="true">
            <p class="promo-left-label" data-offer-label>Quedan</p>
            <p class="promo-left-big" data-offer-big></p>
            <p class="promo-left-small" data-offer-small></p>
          </div>
        </div>
      </div>
    )}

    {featured.map(({ product, copy, card }) => (
      <!-- Featured training (ADR-030): one button, to its sales page. -->
      <article class="reveal featured-card" aria-labelledby={`featured-${product.id}`}>
        <div class="featured-text">
          <p class="featured-pills">
            <span class="featured-pill featured-pill--type"><span class="featured-dot" aria-hidden="true"></span>{copy.hero.pill}</span>
            <span class="featured-pill featured-pill--free">{card.badge}</span>
          </p>
          <h3 id={`featured-${product.id}`} class="featured-title">{copy.hero.titleLine1} <span>{copy.hero.titleLine2}</span></h3>
          <p class="featured-summary">{product.data.summary}</p>
          <ul class="featured-facts">
            {card.facts.map((fact) => <li>{fact}</li>)}
          </ul>
          <a class="featured-cta cta-magnetic" href={productUrl(product)}>{card.cta} <span aria-hidden="true">→</span></a>
        </div>
        <figure class="featured-phone" aria-hidden="true">
          <Picture src={copy.hero.images[0].src} alt="" widths={[240, 480]} sizes="240px" formats={['avif']} fallbackFormat="webp" loading="lazy" />
        </figure>
      </article>
    ))}
    {featured.length > 0 && <p class="featured-kits-label">{featured[0].card.kitsLabel}</p>}

    <!-- Product cards -->
    <div class="reveal-stagger productos-grid" style="display:grid;grid-template-columns:repeat(3,1fr);gap:20px;">
      {products.map((product) => {
        const buyable = isPurchasable(product);
        const isComingSoon = product.data.status === 'coming-soon' && !buyable;
        const chipLabel = isComingSoon
          ? `${product.data.type} · Próximamente`
          : product.data.type;
        const footerLeft = isComingSoon
          ? 'En preparación'
          : product.data.price != null
            ? formatPrice(product.data.price, product.data.currency)
            : 'Consultar';
        const cta = ctaFor(product);
        // Launch promo (D23): price, badge and countdown switch live (src/scripts/offers.ts).
        const offer = buyable ? offerFor(product) : null;
        return (
          <div class="reveal tilt-card" data-offer={offer?.json} style="background:rgba(255,255,255,0.02);border:1px solid rgba(255,255,255,0.06);border-radius:18px;padding:32px 28px;display:flex;flex-direction:column;position:relative;overflow:hidden;">
            <div style={`position:absolute;top:0;left:0;right:0;height:2px;background:${accentText(product.data.accent)};opacity:0.5;`}></div>
            <div style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:18px;">
              <span style={`display:inline-block;width:fit-content;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;padding:4px 10px;border-radius:5px;background:${accentBg(product.data.accent)};color:${accentText(product.data.accent)};font-family:'Plus Jakarta Sans',sans-serif;`}>{chipLabel}</span>
            </div>
            <h3 style="font-size:19px;font-weight:700;color:#fff;margin:0 0 12px 0;font-family:'Plus Jakarta Sans',sans-serif;">{product.data.title}</h3>
            <p style="font-size:14px;line-height:1.65;color:rgba(255,255,255,0.65);margin:0 0 28px 0;flex:1;font-family:'Plus Jakarta Sans',sans-serif;">{product.data.summary}</p>
            <div style="display:flex;justify-content:space-between;align-items:center;padding-top:20px;border-top:1px solid rgba(255,255,255,0.06);">
              <span style="display:flex;flex-direction:column;gap:2px;margin-right:12px;font-family:'Plus Jakarta Sans',sans-serif;">
                {offer ? (
                  <>
                    <span style="white-space:nowrap;">
                      <s data-offer-promo hidden={!offer.activeAtBuild} style="font-size:12.5px;font-weight:500;color:rgba(255,255,255,0.5);margin-right:6px;">{offer.regular}</s>
                      <span data-offer-price style="font-size:16px;font-weight:700;color:#fff;">{offer.activeAtBuild ? offer.promoPrice : offer.regular}</span>
                    </span>
                    <span data-offer-promo hidden={!offer.activeAtBuild} style="font-size:11.5px;font-weight:700;color:#ffb4a6;white-space:nowrap;">Ahorrás {offer.savings}</span>
                    <span data-offer-promo hidden={!offer.activeAtBuild} style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;">{offer.label} hasta el {offer.deadline}, hora de Argentina.</span>
                  </>
                ) : (
                  <span style={`font-size:${buyable ? '16px' : '13px'};font-weight:700;color:${buyable ? '#fff' : 'rgba(255,255,255,0.7)'};white-space:nowrap;`}>{footerLeft}</span>
                )}
                {buyable && <span style="font-size:11.5px;font-weight:500;color:rgba(255,255,255,0.65);white-space:nowrap;">Descarga inmediata</span>}
              </span>
              {cta && (
                <a
                  href={cta.href}
                  class={cta.primary ? 'cta-magnetic' : undefined}
                  style={cta.primary
                    ? "font-size:13px;font-weight:700;padding:10px 22px;border-radius:8px;border:none;background:#E8573D;color:#fff;cursor:pointer;font-family:'Plus Jakarta Sans',sans-serif;text-decoration:none;box-shadow:0 4px 20px rgba(232,87,61,0.3);white-space:nowrap;"
                    : "font-size:12px;font-weight:600;padding:8px 18px;border-radius:7px;border:1px solid rgba(255,255,255,0.1);background:rgba(255,255,255,0.03);color:#fff;cursor:pointer;font-family:'Plus Jakarta Sans',sans-serif;text-decoration:none;"}
                >
                  {offer ? (
                    <>Comprar <span data-offer-promo hidden={!offer.activeAtBuild}>con {offer.percent}% OFF </span>→</>
                  ) : (
                    <>{cta.label} →</>
                  )}
                </a>
              )}
            </div>
          </div>
        );
      })}
    </div>

    <!-- CTA bar -->
    <div style="margin-top:40px;padding:24px 32px;border-radius:14px;background:rgba(0,180,216,0.04);border:1px solid rgba(0,180,216,0.1);display:flex;justify-content:space-between;align-items:center;">
      <span style="font-size:15px;font-weight:600;color:rgba(255,255,255,0.8);font-family:'Plus Jakarta Sans',sans-serif;">¿Necesitás un recurso personalizado para tu equipo u organización?</span>
      <a class="cta-glow cta-magnetic" href={customRequestUrl} target="_blank" rel="noopener noreferrer" style="font-size:13px;font-weight:600;padding:10px 24px;border-radius:8px;border:none;background:#E8573D;color:#fff;cursor:pointer;font-family:'Plus Jakarta Sans',sans-serif;box-shadow:0 4px 16px rgba(232,87,61,0.25);text-decoration:none;">Hablemos →</a>
    </div>
  </div>
</section>

<script>
  // Live launch-promo price and countdown (docs/ventas D23).
  import '../scripts/offers';
</script>

<style is:global>
  /* Launch promo banner (D23). */
  .promo-banner { margin-bottom: 20px; font-family: 'Plus Jakarta Sans', sans-serif; }
  .promo-card { padding: 22px 28px; border-radius: 18px; background: rgba(232, 87, 61, 0.07); border: 1px solid rgba(232, 87, 61, 0.35); }
  .promo-card:not([hidden]) { display: flex; justify-content: space-between; align-items: center; gap: 24px; flex-wrap: wrap; }
  .promo-info { flex: 1 1 360px; min-width: 0; }
  .promo-chip { font-size: 10px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em; padding: 4px 10px; border-radius: 5px; background: #e8573d; color: #fff; white-space: nowrap; }
  .promo-title { font-size: 18px; font-weight: 800; color: #fff; margin: 12px 0 4px 0; }
  .promo-period { font-size: 13.5px; color: rgba(255, 255, 255, 0.72); margin: 0; }
  .promo-progress { display: flex; gap: 4px; max-width: 420px; margin: 14px 0 6px 0; }
  .promo-progress > span { flex: 1; height: 6px; border-radius: 3px; background: rgba(255, 255, 255, 0.12); }
  .promo-progress > span[data-state='past'] { background: rgba(232, 87, 61, 0.5); }
  .promo-progress > span[data-state='today'] { background: #e8573d; }
  .promo-day { font-size: 12px; font-weight: 700; color: rgba(255, 255, 255, 0.75); margin: 0; }
  .promo-left { text-align: right; }
  .promo-left-label { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: #ffb4a6; margin: 0 0 2px 0; }
  .promo-left-big { font-size: 36px; font-weight: 800; color: #fff; line-height: 1.1; margin: 0; font-variant-numeric: tabular-nums; }
  .promo-left-small { font-size: 15px; font-weight: 600; color: rgba(255, 255, 255, 0.8); margin: 2px 0 0 0; font-variant-numeric: tabular-nums; }
  .promo-left-small:empty { display: none; }
  @media (max-width: 640px) {
    .promo-card { padding: 20px; }
    .promo-left { text-align: left; }
    .promo-left-big { font-size: 30px; }
  }
  /* Featured training above the kits (ADR-030). Product palette: coral #CF4630
     with white text is 4,6:1 (AA); cyan on night blue for accents. */
  .featured-card { position: relative; overflow: hidden; display: grid; grid-template-columns: minmax(0, 1fr) 240px; gap: 32px; align-items: center; margin: 0 0 40px 0; padding: 36px 40px 0 40px; border-radius: 22px; border: 1px solid rgba(0, 180, 216, 0.28); background: radial-gradient(ellipse 55% 90% at 85% 40%, rgba(0, 180, 216, 0.14), transparent 70%), linear-gradient(135deg, rgba(0, 180, 216, 0.07), rgba(255, 255, 255, 0.02)); font-family: 'Plus Jakarta Sans', sans-serif; }
  .featured-text { padding-bottom: 36px; min-width: 0; }
  .featured-pills { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 16px 0; }
  .featured-pill { display: inline-flex; align-items: center; gap: 7px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; padding: 5px 12px; border-radius: 100px; }
  .featured-pill--type { color: #00b4d8; border: 1px solid rgba(0, 180, 216, 0.35); }
  .featured-pill--free { color: #0b1a2e; background: #00b4d8; }
  .featured-dot { width: 5px; height: 5px; border-radius: 50%; background: #00b4d8; box-shadow: 0 0 8px #00b4d8; }
  .featured-title { font-size: 30px; font-weight: 800; line-height: 1.12; letter-spacing: -0.03em; color: #fff; margin: 0 0 12px 0; }
  .featured-title span { color: #00b4d8; }
  .featured-summary { font-size: 15.5px; line-height: 1.65; color: rgba(255, 255, 255, 0.75); margin: 0 0 18px 0; max-width: 560px; }
  .featured-facts { display: flex; flex-wrap: wrap; gap: 8px 18px; margin: 0 0 24px 0; padding: 0; list-style: none; font-size: 13.5px; color: rgba(255, 255, 255, 0.82); }
  .featured-facts li::before { content: '✓'; color: #00b4d8; font-weight: 800; margin-right: 6px; }
  .featured-cta { display: inline-flex; align-items: center; gap: 8px; font-size: 14.5px; font-weight: 700; padding: 13px 24px; border-radius: 10px; background: #cf4630; color: #fff; text-decoration: none; box-shadow: 0 4px 20px rgba(207, 70, 48, 0.35); }
  .featured-cta:focus-visible { outline: 3px solid #00b4d8; outline-offset: 3px; }
  .featured-phone { align-self: end; margin: 0; height: 300px; overflow: hidden; border-radius: 28px 28px 0 0; padding: 7px 7px 0 7px; background: #1c2b40; border: 1px solid rgba(255, 255, 255, 0.14); border-bottom: 0; box-shadow: 0 -10px 40px rgba(0, 0, 0, 0.3); }
  .featured-phone img { display: block; width: 100%; height: auto; border-radius: 22px 22px 0 0; }
  .featured-kits-label { display: flex; align-items: center; gap: 12px; margin: 0 0 18px 0; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em; color: rgba(255, 255, 255, 0.6); font-family: 'Plus Jakarta Sans', sans-serif; }
  .featured-kits-label::after { content: ''; flex: 1; height: 1px; background: rgba(255, 255, 255, 0.08); }
  @media (max-width: 768px) {
    .featured-card { grid-template-columns: minmax(0, 1fr); gap: 18px; padding: 26px 20px 0 20px; }
    .featured-text { padding-bottom: 0; }
    .featured-title { font-size: 25px; }
    .featured-cta { display: flex; justify-content: center; }
    .featured-phone { width: 62%; max-width: 240px; height: 230px; margin: 0 auto; }
  }
  /* "Comprar con 56% OFF" must stay inside the card. */
  .productos-grid a.cta-magnetic { padding-left: 14px !important; padding-right: 14px !important; }
</style>
