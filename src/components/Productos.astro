---
// Productos.astro — Sección de productos digitales FENIA
// Reads from src/content/products/ via Astro Content Collections.
// Status 'hidden' is never rendered. 'coming-soon' shows a "PRÓXIMAMENTE" suffix.
// CTA behavior: see ADR-027, ADR-028 and docs/ventas/propuesta-visual.md.
import { getCollection } from 'astro:content';
import { whatsapp } from '../data/site';
import { formatPrice, isPurchasable, kitUrl, notifyUrl, offerFor } from '../lib/sales';

const allProducts = await getCollection('products');
const products = allProducts
  .filter((p) => p.data.status === 'live' || p.data.status === 'coming-soon')
  .sort((a, b) => a.data.order - b.data.order);

const accentText = (a: 'cyan' | 'coral') => (a === 'cyan' ? '#00B4D8' : '#E8573D');
const accentBg = (a: 'cyan' | 'coral') => (a === 'cyan' ? 'rgba(0,180,216,0.1)' : 'rgba(232,87,61,0.1)');

// Shared launch-promo banner (variants 2/3): the first sellable kit's offer.
const bannerOffer = products.filter(isPurchasable).map((p) => offerFor(p)).find((o) => o !== null) ?? null;

const customRequestUrl = whatsapp.url('Hola FENIA, necesito un recurso personalizado para mi equipo u organización');

/**
 * CTA per product (ADR-028, docs/ventas/propuesta-visual.md):
 *  - purchasable (live with a price; also coming-soon on a staging preview
 *    build) → "Comprar" → the kit page, where the buyer's email is asked
 *  - coming-soon → "Avisame cuando esté disponible" → /recursos-gratuitos
 *    (D17: no free-resource promise until one exists; the title comes from
 *    the product id there, never from the URL — finding H-03)
 *  - live without a price → informational card, no button
 */
function ctaFor(product: (typeof products)[number]) {
  const { status, ctaLabel } = product.data;
  if (isPurchasable(product)) {
    return { label: ctaLabel ?? 'Comprar', href: kitUrl(product), primary: true };
  }
  if (status === 'coming-soon') {
    return { label: ctaLabel ?? 'Avisame cuando esté disponible', href: notifyUrl(product), primary: false };
  }
  return null;
}
---

<section id="productos" style="background:#0B1A2E;position:relative;overflow:hidden;">
  <div style="position:absolute;top:30%;right:10%;width:400px;height:400px;border-radius:50%;background:radial-gradient(ellipse,rgba(232,87,61,0.04) 0%,transparent 70%);pointer-events:none;"></div>

  <div style="max-width:1200px;margin:0 auto;padding:100px 48px;position:relative;z-index:2;">
    <!-- Header -->
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:60px;margin-bottom:56px;align-items:end;">
      <div>
        <div style="display:inline-flex;align-items:center;gap:8px;padding:5px 14px;border-radius:100px;border:1px solid rgba(255,255,255,0.08);margin-bottom:20px;">
          <div style="width:5px;height:5px;border-radius:50%;background:#E8573D;"></div>
          <span style="font-size:11px;font-weight:600;color:rgba(255,255,255,0.4);text-transform:uppercase;letter-spacing:0.1em;font-family:'Plus Jakarta Sans',sans-serif;">Productos digitales</span>
        </div>
        <h2 style="font-size:38px;font-weight:800;line-height:1.1;color:#fff;letter-spacing:-0.03em;margin:0;font-family:'Plus Jakarta Sans',sans-serif;">
          Recursos listos para <span style="color:#00B4D8;">implementar</span>
        </h2>
      </div>
      <p style="font-size:15px;line-height:1.7;color:rgba(255,255,255,0.7);margin:0;font-family:'Plus Jakarta Sans',sans-serif;">
        Herramientas descargables basadas en evidencia, diseñadas para aplicar los principios de FENIA de forma autónoma e inmediata.
      </p>
    </div>

    {bannerOffer && (
      <!-- Launch promo banner: variants 2 and 3 (D23). -->
      <div class="pv pv-2 pv-3 promo-banner" data-offer={bannerOffer.json} style="margin-bottom:20px;">
        <div data-offer-promo hidden={!bannerOffer.activeAtBuild} style="padding:22px 28px;border-radius:18px;background:rgba(232,87,61,0.07);border:1px solid rgba(232,87,61,0.35);font-family:'Plus Jakarta Sans',sans-serif;">
          <div class="promo-banner-row">
            <div>
              <span style="font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:0.1em;padding:4px 10px;border-radius:5px;background:#E8573D;color:#fff;white-space:nowrap;">−{bannerOffer.percent}% · Lanzamiento</span>
              <p style="font-size:18px;font-weight:800;color:#fff;margin:12px 0 4px 0;">{bannerOffer.label} en los 3 kits</p>
              <p style="font-size:13.5px;color:rgba(255,255,255,0.7);margin:0;">Promo de {bannerOffer.days} días · termina el {bannerOffer.deadline} (hora de Argentina). Después, {bannerOffer.regular}.</p>
            </div>
            <div aria-hidden="true" class="pv pv-2" style="gap:8px;">
                <span style="display:flex;flex-direction:column;align-items:center;min-width:64px;padding:10px 8px;border-radius:10px;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.12);"><span data-offer-unit="days" style="font-size:26px;font-weight:800;color:#fff;line-height:1;font-variant-numeric:tabular-nums;">–</span><span style="font-size:10.5px;font-weight:600;text-transform:uppercase;letter-spacing:0.08em;color:rgba(255,255,255,0.65);margin-top:6px;">días</span></span>
                <span style="display:flex;flex-direction:column;align-items:center;min-width:64px;padding:10px 8px;border-radius:10px;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.12);"><span data-offer-unit="hours" style="font-size:26px;font-weight:800;color:#fff;line-height:1;font-variant-numeric:tabular-nums;">–</span><span style="font-size:10.5px;font-weight:600;text-transform:uppercase;letter-spacing:0.08em;color:rgba(255,255,255,0.65);margin-top:6px;">horas</span></span>
                <span style="display:flex;flex-direction:column;align-items:center;min-width:64px;padding:10px 8px;border-radius:10px;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.12);"><span data-offer-unit="minutes" style="font-size:26px;font-weight:800;color:#fff;line-height:1;font-variant-numeric:tabular-nums;">–</span><span style="font-size:10.5px;font-weight:600;text-transform:uppercase;letter-spacing:0.08em;color:rgba(255,255,255,0.65);margin-top:6px;">min</span></span>
                <span style="display:flex;flex-direction:column;align-items:center;min-width:64px;padding:10px 8px;border-radius:10px;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.12);"><span data-offer-unit="seconds" style="font-size:26px;font-weight:800;color:#fff;line-height:1;font-variant-numeric:tabular-nums;">–</span><span style="font-size:10.5px;font-weight:600;text-transform:uppercase;letter-spacing:0.08em;color:rgba(255,255,255,0.65);margin-top:6px;">seg</span></span>
            </div>
            <div aria-hidden="true" class="pv pv-3" style="gap:8px;">
                <span style="display:flex;flex-direction:column;align-items:center;min-width:64px;padding:10px 8px;border-radius:10px;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.12);"><span data-offer-unit="totalHours" style="font-size:26px;font-weight:800;color:#fff;line-height:1;font-variant-numeric:tabular-nums;">–</span><span style="font-size:10.5px;font-weight:600;text-transform:uppercase;letter-spacing:0.08em;color:rgba(255,255,255,0.65);margin-top:6px;">horas</span></span>
                <span style="display:flex;flex-direction:column;align-items:center;min-width:64px;padding:10px 8px;border-radius:10px;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.12);"><span data-offer-unit="minutes" style="font-size:26px;font-weight:800;color:#fff;line-height:1;font-variant-numeric:tabular-nums;">–</span><span style="font-size:10.5px;font-weight:600;text-transform:uppercase;letter-spacing:0.08em;color:rgba(255,255,255,0.65);margin-top:6px;">min</span></span>
                <span style="display:flex;flex-direction:column;align-items:center;min-width:64px;padding:10px 8px;border-radius:10px;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.12);"><span data-offer-unit="seconds" style="font-size:26px;font-weight:800;color:#fff;line-height:1;font-variant-numeric:tabular-nums;">–</span><span style="font-size:10.5px;font-weight:600;text-transform:uppercase;letter-spacing:0.08em;color:rgba(255,255,255,0.65);margin-top:6px;">seg</span></span>
            </div>
          </div>
        </div>
      </div>
    )}

    <!-- Product cards -->
    <div class="reveal-stagger productos-grid" style="display:grid;grid-template-columns:repeat(3,1fr);gap:20px;">
      {products.map((product) => {
        const buyable = isPurchasable(product);
        const isComingSoon = product.data.status === 'coming-soon' && !buyable;
        const chipLabel = isComingSoon
          ? `${product.data.type} · Próximamente`
          : product.data.type;
        const footerLeft = isComingSoon
          ? 'En preparación'
          : product.data.price != null
            ? formatPrice(product.data.price, product.data.currency)
            : 'Consultar';
        const cta = ctaFor(product);
        // Launch promo (D23): price, badge and countdown switch live (src/scripts/offers.ts).
        const offer = buyable ? offerFor(product) : null;
        return (
          <div class="reveal tilt-card" data-offer={offer?.json} style="background:rgba(255,255,255,0.02);border:1px solid rgba(255,255,255,0.06);border-radius:18px;padding:32px 28px;display:flex;flex-direction:column;position:relative;overflow:hidden;">
            <div style={`position:absolute;top:0;left:0;right:0;height:2px;background:${accentText(product.data.accent)};opacity:0.5;`}></div>
            <div style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:18px;">
              <span style={`display:inline-block;width:fit-content;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;padding:4px 10px;border-radius:5px;background:${accentBg(product.data.accent)};color:${accentText(product.data.accent)};font-family:'Plus Jakarta Sans',sans-serif;`}>{chipLabel}</span>
              {offer && (
                <span data-offer-promo hidden={!offer.activeAtBuild} style="font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:0.1em;padding:4px 10px;border-radius:5px;background:#E8573D;color:#fff;font-family:'Plus Jakarta Sans',sans-serif;white-space:nowrap;">−{offer.percent}% · Lanzamiento</span>
              )}
            </div>
            <h3 style="font-size:19px;font-weight:700;color:#fff;margin:0 0 12px 0;font-family:'Plus Jakarta Sans',sans-serif;">{product.data.title}</h3>
            <p style="font-size:14px;line-height:1.65;color:rgba(255,255,255,0.65);margin:0 0 28px 0;flex:1;font-family:'Plus Jakarta Sans',sans-serif;">{product.data.summary}</p>
            <div style="display:flex;justify-content:space-between;align-items:center;padding-top:20px;border-top:1px solid rgba(255,255,255,0.06);">
              <span style="display:flex;flex-direction:column;gap:2px;margin-right:12px;font-family:'Plus Jakarta Sans',sans-serif;">
                {offer ? (
                  <>
                    <span style="white-space:nowrap;">
                      <s data-offer-promo hidden={!offer.activeAtBuild} style="font-size:12.5px;font-weight:500;color:rgba(255,255,255,0.5);margin-right:6px;">{offer.regular}</s>
                      <span data-offer-price style="font-size:16px;font-weight:700;color:#fff;">{offer.activeAtBuild ? offer.promoPrice : offer.regular}</span>
                    </span>
                    <span class="pv pv-1" data-offer-promo hidden={!offer.activeAtBuild} aria-hidden="true" style="font-size:11.5px;color:#ffb4a6;font-variant-numeric:tabular-nums;white-space:nowrap;">
                      <strong data-offer-lead style="font-weight:800;"></strong> <span data-offer-rest style="font-size:10.5px;font-weight:600;"></span>
                    </span>
                    <span class="pv pv-2 pv-3" data-offer-promo hidden={!offer.activeAtBuild} style="font-size:11.5px;font-weight:700;color:#ffb4a6;white-space:nowrap;">Ahorrás {offer.savings}</span>
                    <span data-offer-promo hidden={!offer.activeAtBuild} style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;">{offer.label} hasta el {offer.deadline}, hora de Argentina. Después, {offer.regular}.</span>
                  </>
                ) : (
                  <span style={`font-size:${buyable ? '16px' : '13px'};font-weight:700;color:${buyable ? '#fff' : 'rgba(255,255,255,0.7)'};white-space:nowrap;`}>{footerLeft}</span>
                )}
                {buyable && <span style="font-size:11.5px;font-weight:500;color:rgba(255,255,255,0.65);white-space:nowrap;">Descarga inmediata</span>}
              </span>
              {cta && (
                <a
                  href={cta.href}
                  class={cta.primary ? 'cta-magnetic' : undefined}
                  style={cta.primary
                    ? "font-size:13px;font-weight:700;padding:10px 22px;border-radius:8px;border:none;background:#E8573D;color:#fff;cursor:pointer;font-family:'Plus Jakarta Sans',sans-serif;text-decoration:none;box-shadow:0 4px 20px rgba(232,87,61,0.3);white-space:nowrap;"
                    : "font-size:12px;font-weight:600;padding:8px 18px;border-radius:7px;border:1px solid rgba(255,255,255,0.1);background:rgba(255,255,255,0.03);color:#fff;cursor:pointer;font-family:'Plus Jakarta Sans',sans-serif;text-decoration:none;"}
                >
                  {offer ? (
                    <>
                      <span class="pv pv-1">{cta.label} →</span>
                      <span class="pv pv-2">Comprar con {offer.percent}% OFF →</span>
                      <span class="pv pv-3">Comprar a <span data-offer-price>{offer.activeAtBuild ? offer.promoPrice : offer.regular}</span> →</span>
                    </>
                  ) : (
                    <>{cta.label} →</>
                  )}
                </a>
              )}
            </div>
          </div>
        );
      })}
    </div>

    <!-- CTA bar -->
    <div style="margin-top:40px;padding:24px 32px;border-radius:14px;background:rgba(0,180,216,0.04);border:1px solid rgba(0,180,216,0.1);display:flex;justify-content:space-between;align-items:center;">
      <span style="font-size:15px;font-weight:600;color:rgba(255,255,255,0.8);font-family:'Plus Jakarta Sans',sans-serif;">¿Necesitás un recurso personalizado para tu equipo u organización?</span>
      <a class="cta-glow cta-magnetic" href={customRequestUrl} target="_blank" rel="noopener noreferrer" style="font-size:13px;font-weight:600;padding:10px 24px;border-radius:8px;border:none;background:#E8573D;color:#fff;cursor:pointer;font-family:'Plus Jakarta Sans',sans-serif;box-shadow:0 4px 16px rgba(232,87,61,0.25);text-decoration:none;">Hablemos →</a>
    </div>
  </div>
</section>

<script>
  // Live launch-promo price and countdown (docs/ventas D23).
  import '../scripts/offers';

  // TEMPORARY (staging review, D23): ?v=1|2|3 picks how the promo is shown.
  // Removed once the dev chooses; variant 1 is the default.
  const variant = new URLSearchParams(window.location.search).get('v');
  document.documentElement.dataset.pv = variant === '2' || variant === '3' ? variant : '1';
</script>

<style is:global>
  /* Promo presentation variants (temporary, see the script above). */
  html[data-pv='1'] .pv:not(.pv-1),
  html[data-pv='2'] .pv:not(.pv-2),
  html[data-pv='3'] .pv:not(.pv-3),
  html:not([data-pv]) .pv:not(.pv-1) { display: none !important; }
  .promo-banner-row { display: flex; justify-content: space-between; align-items: center; gap: 20px; flex-wrap: wrap; }
  .promo-banner-row > div[aria-hidden] { display: flex; }
  /* Longer button labels in variants 2/3 must stay inside the card. */
  html[data-pv='2'] .tilt-card a.cta-magnetic,
  html[data-pv='3'] .tilt-card a.cta-magnetic { padding-left: 14px !important; padding-right: 14px !important; }
</style>
