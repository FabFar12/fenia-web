---
// gracias.astro — where Mercado Pago sends the buyer back after paying
// (docs/ventas/propuesta-visual.md §3, approved 2026-11-06; ADR-028).
//
// The page never trusts its URL: it asks the server (/api/status.php) with the
// order code (`ref`, 128 random bits) and only shows the download button when
// the server confirms a paid order (threat model A3, A16; test S-06).
// Everything dynamic is set with textContent (threat model D3).
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { whatsapp, sales } from '../data/site';

const waSupportUrl = whatsapp.url('Hola FENIA, compré un kit y necesito ayuda con la descarga.');
---

<Layout title="Tu compra — FENIA" description="Estado de tu compra en FENIA.">
  <Fragment slot="head">
    <meta name="robots" content="noindex, follow" />
  </Fragment>

  <Nav />

  <main class="thanks-main">
    <section class="thanks-section" aria-live="polite">
      <div id="state-checking" class="thanks-state">
        <div class="thanks-spinner" aria-hidden="true"></div>
        <h1 class="thanks-title">Verificando tu pago…</h1>
        <p class="thanks-lead">Esto tarda unos segundos.</p>
      </div>

      <div id="state-paid" class="thanks-state" hidden>
        <div class="thanks-badge"><span class="thanks-badge-dot" aria-hidden="true"></span>Compra confirmada</div>
        <h1 class="thanks-title">¡Listo! Tu kit está pago.</h1>
        <p class="thanks-lead">Descargalo ahora desde acá.</p>
        <a id="download-link" class="thanks-cta-primary" href="/descarga/">Descargar el kit</a>
        <p class="thanks-note">
          También te lo mandamos a <strong id="paid-email">tu email</strong> (revisá Spam o Promociones).
          {sales.downloadPolicy}
        </p>
      </div>

      <div id="state-pending" class="thanks-state" hidden>
        <h1 class="thanks-title">Tu pago se está procesando.</h1>
        <p class="thanks-lead">Te llega el kit por mail apenas Mercado Pago lo acredite. No hace falta que hagas nada más.</p>
      </div>

      <div id="state-unknown" class="thanks-state" hidden>
        <h1 class="thanks-title">No encontramos tu compra.</h1>
        <p class="thanks-lead">
          Si ya pagaste, entrá a <a href="/no-me-llego/">No me llegó</a> con el email que usaste y te reenviamos el kit.
        </p>
      </div>

      <div class="thanks-footer-note">
        <p>{sales.noCardDataNote}</p>
        <p>
          ¿Necesitás ayuda? Escribinos a <a href={`mailto:${sales.supportEmail}`}>{sales.supportEmail}</a>
          o por <a href={waSupportUrl} target="_blank" rel="noopener noreferrer">WhatsApp</a>.
        </p>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  const states = ['checking', 'paid', 'pending', 'unknown'] as const;
  const show = (name: (typeof states)[number]) => {
    for (const s of states) (document.getElementById(`state-${s}`) as HTMLElement).hidden = s !== name;
  };

  const ref = new URLSearchParams(window.location.search).get('ref') ?? '';
  const MAX_TRIES = 20; // ~1 minute

  async function check(attempt: number): Promise<void> {
    if (!/^[a-f0-9]{32}$/.test(ref)) return show('unknown');
    try {
      const res = await fetch(`/api/status.php?ref=${encodeURIComponent(ref)}`, { headers: { Accept: 'application/json' }, cache: 'no-store' });
      const body = res.ok ? await res.json() : null;
      if (body?.state === 'paid' && typeof body.download_url === 'string' && body.download_url.startsWith('/descarga/#t=')) {
        (document.getElementById('download-link') as HTMLAnchorElement).href = body.download_url;
        if (typeof body.email_masked === 'string') (document.getElementById('paid-email') as HTMLElement).textContent = body.email_masked;
        return show('paid');
      }
      if (body?.state === 'pending' || body?.state === 'review') {
        if (attempt < MAX_TRIES) {
          setTimeout(() => check(attempt + 1), 3000);
          return;
        }
        return show('pending');
      }
      if (attempt < 3 && (!res.ok || !body)) {
        setTimeout(() => check(attempt + 1), 3000);
        return;
      }
      show('unknown');
    } catch {
      if (attempt < 3) setTimeout(() => check(attempt + 1), 3000);
      else show('unknown');
    }
  }

  check(0);
</script>

<style>
  .thanks-main { background: #0b1a2e; min-height: 80vh; }
  .thanks-section { max-width: 720px; margin: 0 auto; padding: 100px 48px 80px; color: #fff; font-family: 'Plus Jakarta Sans', sans-serif; }
  .thanks-badge { display: inline-flex; align-items: center; gap: 8px; padding: 5px 14px; border-radius: 100px; border: 1px solid rgba(0, 180, 216, 0.25); background: rgba(0, 180, 216, 0.06); margin-bottom: 24px; font-size: 11px; font-weight: 700; color: rgba(255, 255, 255, 0.75); text-transform: uppercase; letter-spacing: 0.1em; }
  .thanks-badge-dot { width: 6px; height: 6px; border-radius: 50%; background: #00b4d8; box-shadow: 0 0 8px #00b4d8; }
  .thanks-title { font-size: 40px; font-weight: 800; line-height: 1.1; letter-spacing: -0.03em; margin: 0 0 16px 0; }
  .thanks-lead { font-size: 17px; line-height: 1.65; color: rgba(255, 255, 255, 0.75); margin: 0 0 28px 0; max-width: 560px; }
  .thanks-lead a, .thanks-footer-note a { color: #00b4d8; }
  .thanks-cta-primary { display: inline-flex; align-items: center; font-size: 16px; font-weight: 700; padding: 15px 30px; border-radius: 10px; background: #e8573d; color: #fff; box-shadow: 0 4px 20px rgba(232, 87, 61, 0.3); text-decoration: none; }
  .thanks-cta-primary:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
  .thanks-note { font-size: 14px; line-height: 1.65; color: rgba(255, 255, 255, 0.7); margin: 22px 0 0 0; max-width: 560px; }
  .thanks-note strong { color: #fff; }
  .thanks-spinner { width: 28px; height: 28px; border-radius: 50%; border: 3px solid rgba(255, 255, 255, 0.15); border-top-color: #00b4d8; animation: spin 0.9s linear infinite; margin-bottom: 24px; }
  @keyframes spin { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) { .thanks-spinner { animation: none; } }
  .thanks-footer-note { margin-top: 56px; padding-top: 20px; border-top: 1px solid rgba(255, 255, 255, 0.08); font-size: 13px; line-height: 1.65; color: rgba(255, 255, 255, 0.6); }
  .thanks-footer-note p { margin: 0 0 6px 0; }
  @media (max-width: 640px) {
    .thanks-section { padding: 64px 20px 56px; }
    .thanks-title { font-size: 30px; }
    .thanks-cta-primary { width: 100%; justify-content: center; }
  }
</style>
