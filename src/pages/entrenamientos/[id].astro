---
// Training sales page — /entrenamientos/<id>/ (ADR-030). Copy and layout from
// the product team (handoff pagina-de-venta.md v1): copy in
// src/content/trainings/<id>.yaml; price, status and free sample in
// src/content/products/<id>.md.
//
// Buttons by phase:
//  - A, status `sample`: "Probá gratis el día 0" opens the free sample, and
//    "Avisame cuando esté completo" goes to the launch list. Planned price
//    shown, nothing to buy.
//  - B (sales): needs buyer access first. Until it exists, the product schema
//    refuses `live` for trainings, so no page can show a purchase.
//
// Links to the sample are a full page load (data-astro-reload): the app is a
// page of its own, with its own security policy, not an Astro page the client
// router could swap in. `data-sample` marks them for the visit counter (ADR-029).
import { getCollection, getEntry } from 'astro:content';
import { Picture } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { formatPrice, isTraining, notifyUrl } from '../../lib/sales';

export async function getStaticPaths() {
  const products = await getCollection('products', (p) => isTraining(p) && p.data.status !== 'hidden');
  return Promise.all(
    products.map(async (product) => {
      const page = await getEntry('trainings', product.id);
      if (!page) throw new Error(`Training "${product.id}" has no page copy: add src/content/trainings/${product.id}.yaml`);
      return { params: { id: product.id }, props: { product, page } };
    }),
  );
}

const { product, page } = Astro.props;
const data = product.data;
const c = page.data;
const sampleUrl = data.status === 'sample' ? data.sampleUrl : undefined;
const notifyHref = notifyUrl(product);
const planned = data.status === 'sample' && data.plannedPrice != null && data.price != null
  ? { launch: formatPrice(data.plannedPrice, data.currency), list: formatPrice(data.price, data.currency) }
  : null;
const ogImage = `/entrenamientos/${product.id}/og.jpg`;
---

<Layout title={c.seo.title} description={c.seo.description} image={ogImage}>
  <Nav />

  <main class="tr-main">
    <!-- 3.1 Hero -->
    <section class="tr-sec tr-dark tr-hero" aria-labelledby="tr-title">
      <div class="tr-wrap tr-hero-grid">
        <header class="tr-hero-text">
          <p class="tr-pill"><span class="tr-pill-dot" aria-hidden="true"></span>{c.hero.pill}</p>
          <h1 id="tr-title" class="tr-h1">{c.hero.titleLine1}<span class="tr-h1-accent">{c.hero.titleLine2}</span></h1>
          <p class="tr-lead">{c.hero.subtitle}</p>
          <p class="tr-ctas">
            {sampleUrl && (
              <a class="tr-btn tr-btn--primary" href={sampleUrl} data-sample data-astro-reload data-astro-prefetch="false">{c.ctas.sample} <span aria-hidden="true">→</span></a>
            )}
            <a class="tr-btn tr-btn--ghost" href={notifyHref}>{c.ctas.notify}</a>
          </p>
          {sampleUrl && <p class="tr-note">{c.hero.note}</p>}
        </header>
        <div class="tr-hero-phones">
          {c.hero.images.map((img, i) => (
            <figure class={`tr-phone tr-phone--hero tr-phone--${i + 1}`}>
              <Picture src={img.src} alt={img.alt} widths={[260, 520]} sizes="(min-width: 900px) 260px, 44vw" formats={['avif']} fallbackFormat="webp" loading="eager" fetchpriority={i === 0 ? 'high' : 'auto'} />
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- 3.2 El problema -->
    <section class="tr-sec tr-light" aria-labelledby="tr-h-problem">
      <div class="tr-wrap tr-narrow">
        <h2 id="tr-h-problem" class="tr-h2">{c.problem.title}</h2>
        <p class="tr-text">{c.problem.text}</p>
        <aside class="tr-fact" aria-label="Dato">
          <p class="tr-label">Dato</p>
          <p>{c.problem.fact}</p>
        </aside>
      </div>
    </section>

    <!-- 3.3 Cómo funciona -->
    <section class="tr-sec tr-light tr-alt" aria-labelledby="tr-h-how">
      <div class="tr-wrap">
        <h2 id="tr-h-how" class="tr-h2">{c.how.title}</h2>
        <ul class="tr-cards">
          {c.how.cards.map((card, i) => (
            <li class="tr-card">
              <span class="tr-card-icon" aria-hidden="true">
                {i === 0 && <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>}
                {i === 1 && <svg viewBox="0 0 24 24"><rect x="4" y="5" width="16" height="15" rx="2" /><path d="M8 3v4M16 3v4M4 10h16" /></svg>}
                {i === 2 && <svg viewBox="0 0 24 24"><path d="M5 18l1.2-3.6A7 7 0 1 1 9 18.6z" /></svg>}
                {i >= 3 && <svg viewBox="0 0 24 24"><rect x="7" y="2.5" width="10" height="19" rx="2" /><path d="M11 18.5h2" /></svg>}
              </span>
              <h3 class="tr-h3">{card.title}</h3>
              <p>{card.text}</p>
            </li>
          ))}
        </ul>

        <div class="tr-session">
          <div class="tr-session-text">
            <h3 class="tr-h3 tr-h3--big">{c.how.session.title}</h3>
            <ol class="tr-steps">
              {c.how.session.steps.map((step) => (
                <li><strong>{step.title}</strong> {step.text}</li>
              ))}
            </ol>
          </div>
          <div class="tr-strip" tabindex="0" role="region" aria-label={`Capturas: ${c.how.session.title.toLowerCase()}`}>
            {c.how.session.images.map((img) => (
              <figure class="tr-phone tr-phone--strip">
                <Picture src={img.src} alt={img.alt} widths={[220, 440]} sizes="220px" formats={['avif']} fallbackFormat="webp" loading="lazy" />
              </figure>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- 3.4 Qué vas a poder hacer -->
    <section class="tr-sec tr-light" aria-labelledby="tr-h-outcomes">
      <div class="tr-wrap tr-narrow">
        <h2 id="tr-h-outcomes" class="tr-h2">{c.outcomes.title}</h2>
        <ul class="tr-checks">
          {c.outcomes.items.map((item) => <li>{item}</li>)}
        </ul>
        <p class="tr-callout">{c.outcomes.closing}</p>
      </div>
    </section>

    <!-- 3.5 El recorrido -->
    <section class="tr-sec tr-light tr-alt" aria-labelledby="tr-h-journey">
      <div class="tr-wrap tr-narrow">
        <h2 id="tr-h-journey" class="tr-h2">{c.journey.title}</h2>
        <table class="tr-table">
          <thead>
            <tr><th scope="col">Semana</th><th scope="col">Foco</th></tr>
          </thead>
          <tbody>
            {c.journey.rows.map((row) => (
              <tr><th scope="row">{row.week}</th><td>{row.focus}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- 3.6 Por qué funciona -->
    <section class="tr-sec tr-dark" aria-labelledby="tr-h-why">
      <div class="tr-wrap tr-why-grid">
        <div class="tr-why-text">
          <h2 id="tr-h-why" class="tr-h2">{c.why.title}</h2>
          <p class="tr-text">{c.why.text}</p>
          <ul class="tr-why-items">
            {c.why.items.map((item) => (
              <li><h3 class="tr-h3">{item.title}</h3><p>{item.text}</p></li>
            ))}
          </ul>
          <aside class="tr-nopromise" aria-labelledby="tr-h-nopromise">
            <h3 id="tr-h-nopromise" class="tr-label">{c.why.noPromise.title}</h3>
            <p>{c.why.noPromise.text}</p>
          </aside>
        </div>
        <figure class="tr-phone tr-phone--why">
          <Picture src={c.why.image.src} alt={c.why.image.alt} widths={[260, 520]} sizes="(min-width: 900px) 260px, 70vw" formats={['avif']} fallbackFormat="webp" loading="lazy" />
        </figure>
      </div>
    </section>

    <!-- 3.7 Qué incluye -->
    <section class="tr-sec tr-light" aria-labelledby="tr-h-includes">
      <div class="tr-wrap tr-narrow">
        <h2 id="tr-h-includes" class="tr-h2">{c.includes.title}</h2>
        <ul class="tr-checks tr-checks--two">
          {c.includes.items.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </section>

    <!-- 3.8 Para quién es -->
    <section class="tr-sec tr-light tr-alt" aria-labelledby="tr-h-audience">
      <div class="tr-wrap tr-narrow">
        <h2 id="tr-h-audience" class="tr-h2">{c.audience.title}</h2>
        <div class="tr-fit">
          <p class="tr-card tr-fit-yes"><strong>{c.audience.yes.title}</strong> {c.audience.yes.text}</p>
          <p class="tr-card tr-fit-no"><strong>{c.audience.no.title}</strong> {c.audience.no.text}</p>
        </div>
        <p class="tr-text tr-others">{c.audience.others.before}<a href={c.audience.others.href}>{c.audience.others.linkText}</a>{c.audience.others.after}</p>
      </div>
    </section>

    <!-- 3.9 Precio (phase A: planned price, nothing to buy) -->
    {planned && (
      <section class="tr-sec tr-light" aria-labelledby="tr-h-price">
        <div class="tr-wrap tr-narrow">
          <h2 id="tr-h-price" class="tr-h2">{c.price.title}</h2>
          <div class="tr-price-card">
            <p class="tr-price">Precio de lanzamiento previsto: <strong>{planned.launch}</strong> (lista {planned.list})</p>
            <p class="tr-price-note">{c.price.note}</p>
            <p class="tr-ctas">
              {sampleUrl && (
                <a class="tr-btn tr-btn--primary" href={sampleUrl} data-sample data-astro-reload data-astro-prefetch="false">{c.ctas.sample} <span aria-hidden="true">→</span></a>
              )}
              <a class="tr-btn tr-btn--outline" href={notifyHref}>{c.ctas.notify}</a>
            </p>
          </div>
        </div>
      </section>
    )}

    <!-- 3.10 Preguntas frecuentes -->
    <section class="tr-sec tr-light tr-alt" aria-labelledby="tr-h-faq">
      <div class="tr-wrap tr-narrow">
        <h2 id="tr-h-faq" class="tr-h2">{c.faq.title}</h2>
        <div class="tr-faq">
          {c.faq.items.map((item) => (
            <details>
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- 3.11 Testimonios: hidden until the pilot gives real ones with written permission. -->

    <!-- 3.12 Cierre -->
    <section class="tr-sec tr-dark tr-closing" aria-labelledby="tr-h-closing">
      <div class="tr-wrap tr-narrow">
        <h2 id="tr-h-closing" class="tr-h2">{c.closing.title}</h2>
        <p class="tr-text">{c.closing.text}</p>
        <p class="tr-ctas tr-ctas--center">
          {sampleUrl && (
            <a class="tr-btn tr-btn--primary" href={sampleUrl} data-sample data-astro-reload data-astro-prefetch="false">{c.ctas.sample} <span aria-hidden="true">→</span></a>
          )}
          <a class="tr-btn tr-btn--ghost" href={notifyHref}>{c.ctas.notify}</a>
        </p>
      </div>
    </section>

    {sampleUrl && c.mobile && (
      <>
        <!-- Phone only: «Probá gratis» stays at hand once the hero's buttons scroll away. -->
        <div class="tr-bar" data-tr-bar inert>
          <p class="tr-bar-text"><b>{c.mobile.stickyBar.title}</b><span>{c.mobile.stickyBar.text}</span></p>
          <a class="tr-bar-cta" href={sampleUrl} data-sample data-astro-reload data-astro-prefetch="false">{c.mobile.stickyBar.cta} <span aria-hidden="true">→</span></a>
        </div>

        <!-- Inside Instagram, Facebook or TikTok: their browsers can lose the progress. -->
        <dialog id="tr-inapp" class="tr-sheet" aria-labelledby="tr-inapp-title" data-sample-url={sampleUrl} data-text={c.mobile.inApp.text} data-copied={c.mobile.inApp.copied}>
          <span class="tr-sheet-tag">{c.mobile.inApp.tag}</span>
          <h2 id="tr-inapp-title" class="tr-sheet-title" data-title-iphone={c.mobile.inApp.titleIphone}>{c.mobile.inApp.title}</h2>
          <p class="tr-sheet-text" data-inapp-text></p>
          <a class="tr-btn tr-btn--primary tr-sheet-btn" data-inapp-android hidden>{c.mobile.inApp.openChrome} <span aria-hidden="true">→</span></a>
          <ol class="tr-sheet-steps" data-inapp-iphone hidden>
            {c.mobile.inApp.steps.map((step, i) => <li><b>{i + 1}</b><span>{step}</span></li>)}
          </ol>
          <button type="button" class="tr-btn tr-btn--outline tr-sheet-btn" data-inapp-copy>{c.mobile.inApp.copy}</button>
          <button type="button" class="tr-sheet-continue" data-inapp-continue>{c.mobile.inApp.continue}</button>
        </dialog>
      </>
    )}
  </main>

  <Footer />
</Layout>

<script>
  // Phone helpers of the sales page (approved 2026-11-20).
  // 1. Sticky bar: shown once the hero's buttons scroll away, hidden again at
  //    the closing section (which has its own buttons). Phones only (CSS).
  // 2. Inside Instagram, Facebook or TikTok, «Probá gratis» first explains how
  //    to open the sample in the phone's browser: those in-app browsers keep
  //    their own storage and can lose the progress (H-12 in docs/ventas).
  //    The click is still counted (src/scripts/visits.ts).
  function inAppName(ua: string): string | null {
    if (/Instagram/i.test(ua)) return 'Instagram';
    if (/FBAN|FBAV|FB_IAB|FBIOS/i.test(ua)) return 'Facebook';
    if (/TikTok|musical_ly|BytedanceWebview/i.test(ua)) return 'TikTok';
    return null;
  }

  function setUpBar() {
    const bar = document.querySelector<HTMLElement>('[data-tr-bar]');
    const hero = document.querySelector('.tr-hero .tr-ctas');
    const closing = document.querySelector('.tr-closing');
    if (!bar || !hero || !closing || !('IntersectionObserver' in window)) return;
    let heroInView = true;
    let closingReached = false;
    const update = () => {
      const on = !heroInView && !closingReached;
      bar.classList.toggle('is-on', on);
      bar.inert = !on;
    };
    new IntersectionObserver(([e]) => {
      heroInView = e.isIntersecting || e.boundingClientRect.top > 0;
      update();
    }).observe(hero);
    new IntersectionObserver(([e]) => {
      closingReached = e.isIntersecting || e.boundingClientRect.top < 0;
      update();
    }).observe(closing);
  }

  function setUpInApp() {
    const dialog = document.getElementById('tr-inapp') as HTMLDialogElement | null;
    const where = inAppName(navigator.userAgent);
    if (!dialog || !where || typeof dialog.showModal !== 'function') return;
    const sample = new URL(dialog.dataset.sampleUrl ?? '/', location.href).href;
    const android = /Android/i.test(navigator.userAgent);
    dialog.querySelector<HTMLElement>('[data-inapp-text]')!.textContent = (dialog.dataset.text ?? '').replace('{app}', where);
    const title = dialog.querySelector<HTMLElement>('.tr-sheet-title')!;
    if (!android) title.textContent = title.dataset.titleIphone ?? title.textContent;
    const chrome = dialog.querySelector<HTMLAnchorElement>('[data-inapp-android]')!;
    const steps = dialog.querySelector<HTMLElement>('[data-inapp-iphone]')!;
    if (android) {
      const u = new URL(sample);
      chrome.href = `intent://${u.host}${u.pathname}#Intent;scheme=https;package=com.android.chrome;S.browser_fallback_url=${encodeURIComponent(sample)};end`;
      chrome.hidden = false;
    } else {
      steps.hidden = false;
    }
    const copy = dialog.querySelector<HTMLButtonElement>('[data-inapp-copy]')!;
    copy.onclick = () => {
      navigator.clipboard?.writeText(sample).then(() => { copy.textContent = dialog.dataset.copied ?? copy.textContent; }, () => {});
    };
    dialog.querySelector<HTMLButtonElement>('[data-inapp-continue]')!.onclick = () => { location.href = sample; };
    // Tapping the dimmed area closes it.
    dialog.onclick = (ev) => { if (ev.target === dialog) dialog.close(); };
    dialog.dataset.ready = '1';
  }

  // Once per document: any «Probá gratis» (hero, price, closing, sticky bar).
  document.addEventListener('click', (ev) => {
    const link = (ev.target as Element | null)?.closest?.('a[data-sample]');
    const dialog = document.getElementById('tr-inapp') as HTMLDialogElement | null;
    if (!link || !dialog || dialog.dataset.ready !== '1' || dialog.open) return;
    ev.preventDefault();
    dialog.showModal();
  });

  document.addEventListener('astro:page-load', () => {
    setUpBar();
    setUpInApp();
  });
</script>

<style>
  /* Product palette (handoff brief): night blue #0B1A2E, cyan #00B4D8 on dark,
     deep cyan #006B87 for text on light, action coral #CF4630 (white on it is
     4,6:1, AA). Dark sections to think, light ones to read. */
  .tr-main { font-family: 'Plus Jakarta Sans Variable', 'Plus Jakarta Sans', sans-serif; }
  .tr-sec { padding: 88px 0; }
  .tr-dark { background: #0b1a2e; color: #fff; }
  .tr-light { background: #ffffff; color: #0b1a2e; }
  .tr-alt { background: #f4f6fa; }
  .tr-wrap { max-width: 1100px; margin: 0 auto; padding: 0 48px; }
  .tr-narrow { max-width: 820px; }

  .tr-h1 { font-size: 52px; font-weight: 800; line-height: 1.06; letter-spacing: -0.035em; margin: 0 0 20px 0; }
  .tr-h1-accent { display: block; color: #00b4d8; }
  .tr-h2 { font-size: 34px; font-weight: 800; line-height: 1.15; letter-spacing: -0.03em; margin: 0 0 20px 0; }
  .tr-h3 { font-size: 17px; font-weight: 700; line-height: 1.35; margin: 0 0 6px 0; }
  .tr-h3--big { font-size: 22px; letter-spacing: -0.01em; margin-bottom: 18px; }
  .tr-text { font-size: 17px; line-height: 1.7; margin: 0 0 20px 0; color: #3d4a5c; }
  .tr-dark .tr-text { color: rgba(255, 255, 255, 0.78); }
  .tr-lead { font-size: 19px; line-height: 1.6; color: rgba(255, 255, 255, 0.8); margin: 0 0 32px 0; max-width: 540px; }
  .tr-label { font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em; color: #006b87; margin: 0 0 8px 0; }
  .tr-dark .tr-label { color: #00b4d8; }

  /* Pill, as in the site's section labels. */
  .tr-pill { display: inline-flex; align-items: center; gap: 8px; padding: 6px 14px; border-radius: 100px; border: 1px solid rgba(0, 180, 216, 0.3); margin: 0 0 22px 0; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em; color: #00b4d8; }
  .tr-pill-dot { width: 6px; height: 6px; border-radius: 50%; background: #00b4d8; box-shadow: 0 0 8px #00b4d8; }

  /* Buttons. */
  .tr-ctas { display: flex; flex-wrap: wrap; gap: 12px; margin: 0; }
  .tr-ctas--center { justify-content: center; }
  .tr-btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 48px; padding: 13px 24px; border-radius: 12px; font-size: 15.5px; font-weight: 700; text-decoration: none; text-align: center; transition: transform 150ms ease, box-shadow 150ms ease, background-color 150ms ease; }
  .tr-btn--primary { background: #cf4630; color: #fff; box-shadow: 0 6px 22px rgba(207, 70, 48, 0.35); }
  .tr-btn--primary:hover { transform: translateY(-1px); box-shadow: 0 8px 26px rgba(207, 70, 48, 0.45); }
  .tr-btn--ghost { border: 1px solid rgba(255, 255, 255, 0.28); color: #fff; }
  .tr-btn--ghost:hover { background: rgba(255, 255, 255, 0.06); }
  .tr-btn--outline { border: 1px solid #006b87; color: #006b87; }
  .tr-btn--outline:hover { background: rgba(0, 107, 135, 0.06); }
  .tr-btn:focus-visible { outline: 3px solid #00b4d8; outline-offset: 3px; }
  .tr-note { font-size: 14.5px; font-style: italic; color: rgba(255, 255, 255, 0.7); margin: 16px 0 0 0; }

  /* Phone frame: a plain rounded frame around a real capture, no fake status bar. */
  .tr-phone { margin: 0; border-radius: 30px; padding: 7px; background: #1c2b40; border: 1px solid rgba(255, 255, 255, 0.14); box-shadow: 0 24px 60px rgba(0, 0, 0, 0.35); }
  .tr-light .tr-phone { background: #0b1a2e; border-color: #0b1a2e; box-shadow: 0 18px 44px rgba(11, 26, 46, 0.18); }
  .tr-phone :global(img) { display: block; width: 100%; height: auto; border-radius: 23px; }

  /* Hero. */
  .tr-hero { padding: 72px 0 88px; overflow: hidden; }
  .tr-hero-grid { display: grid; grid-template-columns: minmax(0, 1fr) 460px; gap: 48px; align-items: center; }
  .tr-hero-phones { position: relative; height: 560px; }
  .tr-phone--hero { position: absolute; width: 250px; }
  .tr-phone--1 { left: 0; top: 0; transform: rotate(-3deg); }
  .tr-phone--2 { right: 0; top: 48px; transform: rotate(3deg); }

  /* The problem. */
  .tr-fact { margin: 28px 0 0 0; padding: 22px 24px; border-radius: 16px; background: #eaf6f9; border-left: 4px solid #006b87; }
  .tr-fact p:last-child { margin: 0; font-size: 16.5px; line-height: 1.65; color: #0b1a2e; }

  /* How it works. */
  .tr-cards { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; list-style: none; padding: 0; margin: 8px 0 56px 0; }
  .tr-card { background: #fff; border: 1px solid #e2e8f0; border-radius: 16px; padding: 22px 20px; }
  .tr-card p { margin: 0; font-size: 15px; line-height: 1.6; color: #3d4a5c; }
  .tr-card-icon { display: inline-flex; width: 40px; height: 40px; border-radius: 12px; background: #e6f4f7; align-items: center; justify-content: center; margin-bottom: 14px; }
  .tr-card-icon svg { width: 22px; height: 22px; fill: none; stroke: #006b87; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .tr-session { display: grid; grid-template-columns: minmax(0, 300px) minmax(0, 1fr); gap: 40px; align-items: center; }
  .tr-steps { list-style: none; counter-reset: step; padding: 0; margin: 0; display: grid; gap: 12px; }
  .tr-steps li { counter-increment: step; position: relative; padding: 4px 0 4px 44px; font-size: 16px; line-height: 1.5; color: #3d4a5c; }
  .tr-steps li::before { content: counter(step); position: absolute; left: 0; top: 0; width: 30px; height: 30px; border-radius: 50%; background: #0b1a2e; color: #fff; font-size: 14px; font-weight: 700; display: flex; align-items: center; justify-content: center; }
  .tr-steps strong { color: #0b1a2e; }
  .tr-strip { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .tr-strip:focus-visible { outline: 3px solid #006b87; outline-offset: 4px; border-radius: 8px; }

  /* Lists with checks. */
  .tr-checks { list-style: none; padding: 0; margin: 4px 0 28px 0; display: grid; gap: 12px; }
